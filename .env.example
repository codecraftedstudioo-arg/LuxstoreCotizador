# Google Apps Script URL for exchange rate
# This is the deployed URL of the Apps Script attached to the admin's private Google Sheet
VITE_EXCHANGE_RATE_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_MARKET_PRICES_URL=https://script.google.com/macros/s/YOUR_MARKET_SCRIPT_ID/exec

# Panel Admin API base. Si se define, las cotizaciones salen del panel en vez
# de los Apps Script de arriba (cutover). Vaciar para volver atrás.
VITE_PANEL_API_URL=https://electronic-point-admin.vercel.app/api/v1
