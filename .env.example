# Google Apps Script URL for exchange rate
VITE_EXCHANGE_RATE_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Google Apps Script URL for market prices (Plan Canje)
VITE_MARKET_PRICES_URL=https://script.google.com/macros/s/YOUR_MARKET_SCRIPT_ID/exec

# --- Admin Luxstore (/admin) — server only, NO prefix VITE_ ---
# Precios del cotizador: panel embebido en /api/v1 (administrado en /admin).
ADMIN_PASSWORD=luxstore-admin
ADMIN_SESSION_SECRET=change-me-in-production
# En Vercel, para que Guardar persista fuera del filesystem:
# BLOB_READ_WRITE_TOKEN=
